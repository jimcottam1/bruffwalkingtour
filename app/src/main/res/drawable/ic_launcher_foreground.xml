<?xml version="1.0" encoding="utf-8"?>
<!-- Heritage monument (obelisk) — echoes the Sean Wall Monument at the centre
     of the tour. Gold, lit from the left, on the ink adaptive background.
     Art sits inside the adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- pyramidion + shaft: one lit-from-left gradient -->
    <path android:pathData="M54,20 L64,39 L44,39 Z M46,39 L62,39 L65,79 L43,79 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43" android:startY="0"
                android:endX="66" android:endY="0"
                android:type="linear">
                <item android:color="#F0C572" android:offset="0" />
                <item android:color="#C8922A" android:offset="0.55" />
                <item android:color="#A2701D" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- stepped plinth -->
    <path android:fillColor="#C8922A" android:pathData="M39,79 L69,79 L69,85 L39,85 Z" />
    <path android:fillColor="#B4801F" android:pathData="M34,85 L74,85 L74,91 L34,91 Z" />
</vector>
