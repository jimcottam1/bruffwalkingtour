<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".IntroActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_lg">

            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_lg"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/intro_title"
                android:textAppearance="@style/TextAppearance.Bruff.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/intro_tagline"
                android:textAppearance="@style/TextAppearance.Bruff.BodyMuted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/help_link"
                style="@style/Widget.Bruff.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/help_button" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:contentPadding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatCell">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intro_stat_time"
                            android:textAppearance="@style/TextAppearance.Bruff.StatValue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/intro_stat_time_label"
                            android:textAppearance="@style/TextAppearance.Bruff.Label" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCell">
                        <TextView
                            android:id="@+id/locations_count_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Bruff.StatValue"
                            tools:text="4 stops" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/intro_stat_stops_label"
                            android:textAppearance="@style/TextAppearance.Bruff.Label" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatCell">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/intro_stat_effort"
                            android:textAppearance="@style/TextAppearance.Bruff.StatValue" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/intro_stat_effort_label"
                            android:textAppearance="@style/TextAppearance.Bruff.Label" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/intro_highlights_title"
                android:textAppearance="@style/TextAppearance.Bruff.Headline" />

            <LinearLayout
                android:id="@+id/highlights_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- Pinned call-to-action — always visible, never scrolls off screen -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_tour_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_margin"
        android:text="@string/intro_cta" />

</LinearLayout>
