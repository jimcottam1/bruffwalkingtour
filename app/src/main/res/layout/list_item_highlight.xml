<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/highlight_number"
        style="@style/Widget.Bruff.Badge"
        android:layout_marginEnd="@dimen/space_md"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/highlight_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Bruff.Title"
            tools:text="Thomas Fitzgerald Centre" />

        <TextView
            android:id="@+id/highlight_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Bruff.BodyMuted"
            tools:text="Heritage centre in a former courthouse." />

    </LinearLayout>

</LinearLayout>
