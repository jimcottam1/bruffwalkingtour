<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <org.osmdroid.views.MapView
        android:id="@+id/mapview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/help_button"
        style="@style/Widget.Bruff.MapPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="@dimen/space_md"
        android:text="@string/help_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recenter_button"
        style="@style/Widget.Bruff.MapPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/space_md"
        android:text="@string/recenter_button"
        android:visibility="gone" />

    <TextView
        android:id="@+id/progress_chip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/map_chip_height"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="@dimen/space_md"
        android:background="@drawable/bg_map_pill"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_md"
        android:textAppearance="@style/TextAppearance.Bruff.NavSecondary"
        android:textColor="@color/on_dark"
        tools:text="Stop 1 of 4" />

    <LinearLayout
        android:id="@+id/bottom_info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_map_panel"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            android:id="@+id/navigation_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_locating"
            android:textAppearance="@style/TextAppearance.Bruff.NavPrimary"
            tools:text="Head north to Sean Wall Monument" />

        <TextView
            android:id="@+id/distance_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Bruff.NavSecondary"
            tools:text="220 m · 3 min" />

        <TextView
            android:id="@+id/gps_accuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textAppearance="@style/TextAppearance.Bruff.NavSecondary"
            android:textSize="11sp"
            tools:text="GPS ±8 m" />

    </LinearLayout>

    <!-- Arrival card — shown the moment the user reaches a stop, sits just above
         the navigation bar with an explicit Explore action. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/arrival_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_info_bar"
        android:layout_margin="@dimen/space_md"
        android:visibility="gone"
        app:cardElevation="6dp"
        app:contentPadding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/arrival_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/arrival_card_title_default"
                android:textAppearance="@style/TextAppearance.Bruff.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/arrival_card_hint"
                android:textAppearance="@style/TextAppearance.Bruff.BodyMuted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/arrival_card_listen"
                style="@style/Widget.Bruff.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/narration_play"
                android:visibility="gone"
                app:icon="@drawable/ic_play_small"
                app:iconGravity="textStart"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/arrival_card_dismiss"
                    style="@style/Widget.Bruff.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arrival_card_dismiss" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/arrival_card_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/arrival_card_explore" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/boundary_gate_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="@dimen/space_lg"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/gate_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/gate_locating"
            android:textColor="@color/on_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gate_distance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Bruff.NavSecondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_tour_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:minWidth="220dp"
            android:text="@string/start_tour_button"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gate_override_button"
            style="@style/Widget.Bruff.Button.TextOnDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/gate_start_anyway"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
