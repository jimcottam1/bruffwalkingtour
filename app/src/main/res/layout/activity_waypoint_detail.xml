<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".WaypointDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/detail_toolbar_title" />

    <ScrollView
        android:id="@+id/waypoint_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/waypoint_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:layout_marginBottom="@dimen/space_lg"
                android:contentDescription="@string/detail_toolbar_title"
                android:scaleType="centerCrop"
                android:src="@drawable/img_waypoint_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Bruff.Hero" />

            <TextView
                android:id="@+id/waypoint_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Bruff.Headline"
                tools:text="Thomas Fitzgerald Centre" />

            <TextView
                android:id="@+id/waypoint_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.Bruff.Body"
                tools:text="Heritage centre in a former courthouse." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/detail_history_title"
                android:textAppearance="@style/TextAppearance.Bruff.Title" />

            <TextView
                android:id="@+id/waypoint_historical_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Bruff.Body"
                tools:text="Historical information about this location." />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continue_tour_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_margin"
        android:text="@string/detail_continue" />

</LinearLayout>
